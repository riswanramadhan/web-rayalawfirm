# Salin menjadi .env.local (lokal) dan isi juga di Environment Variables hosting (mis. Vercel).

# --- Supabase (Project Settings → API) -------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# "anon public" key (atau publishable key sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# HANYA untuk script lokal `npm run admin:create`. JANGAN dipasang di hosting
# dan JANGAN diberi awalan NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Kontak developer di dialog MODE HOLD -----------------------------------
# Muncul saat admin mencoba menyimpan sebelum fitur pembaruan diaktifkan.
NEXT_PUBLIC_DEVELOPER_NAME=Tim Developer
# Nomor WhatsApp format internasional tanpa "+", mis. 6281234567890
NEXT_PUBLIC_DEVELOPER_WHATSAPP=
# Alternatif bila tidak memakai WhatsApp
NEXT_PUBLIC_DEVELOPER_EMAIL=

# --- SEO (opsional) ---------------------------------------------------------
# Kunci IndexNow (Bing, Yandex, Seznam, Naver — juga dipakai ChatGPT Search via Bing).
# Isi dengan string acak 32 karakter [a-zA-Z0-9-]. Kosongkan untuk menonaktifkan.
INDEXNOW_KEY=
